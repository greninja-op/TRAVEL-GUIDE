{"$schema": "http://json-schema.org/draft-07/schema#", "description": "Travel Guide POI pack format v1 (see travel-guide/content/README.md)", "required": ["city_id", "city_name", "pack_version", "pois", "routes"], "type": "object", "properties": {"city_id": {"type": "string"}, "city_name": {"type": "string"}, "pack_version": {"type": "string"}, "pois": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "name", "lat", "lng", "radius_m", "category", "summary", "history", "fun_facts", "see_list", "sources"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "lat": {"type": "number", "minimum": -90, "maximum": 90}, "lng": {"type": "number", "minimum": -180, "maximum": 180}, "radius_m": {"type": "number", "minimum": 10, "maximum": 500}, "category": {"type": "string"}, "summary": {"type": "string"}, "history": {"type": "string"}, "is_legend": {"type": "boolean"}, "fun_facts": {"type": "array", "items": {"type": "string"}}, "see_list": {"type": "array", "items": {"type": "string"}}, "hours": {"type": ["object", "null"], "required": ["open", "close"], "properties": {"open": {"type": "string"}, "close": {"type": "string"}}}, "sources": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}}, "routes": {"type": "array", "items": {"type": "object", "required": ["id", "name", "ordered_poi_ids", "est_minutes"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "ordered_poi_ids": {"type": "array", "items": {"type": "string"}}, "est_minutes": {"type": "number"}}}}}}
