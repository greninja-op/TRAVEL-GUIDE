# Local-only terminal state (Kelvra pattern — never pushed)
CONTEXT.md
sessions/

# Android/Gradle build artifacts
.gradle/
**/.gradle/
mobile/.gradle/
shared-core/.gradle/
mobile/build/
mobile/app/build/
mobile/local.properties
shared-core/build/
*.apk
*.aab

# Kotlin compiler session/error logs (in-line comments are NOT supported in
# .gitignore — a trailing "# ..." becomes part of the pattern and never matches)
mobile/.kotlin/

# Generated demo exports (python tools/demo.py --yes) — never committed
demo-out/

# Workspace-local toolchain (JDK etc.) — never committed
.tools/

# Vercel CLI local project link — never committed
.vercel/

# Local QA screenshots and reports
website/shots/

# Temporary device screencaps and test audio
*.png
**/*.png
*.wav

# The website's stitched map is a production asset, not a screencap
!website/assets/img/fort-kochi-map.png

# Python tool caches
__pycache__/
*.pyc

