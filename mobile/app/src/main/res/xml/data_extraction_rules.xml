<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Disallow cloud backup of all app databases, preferences, and internal storage -->
        <exclude path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Disallow device-to-device migration of private history and keys -->
        <exclude path="." />
    </device-transfer>
</data-extraction-rules>
