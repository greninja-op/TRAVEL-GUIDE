<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws its own UI; the platform theme only needs to remove the
         action bar and set a sane window background (outdoor-readable light). -->
    <style name="Theme.TravelGuide" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>
</resources>
