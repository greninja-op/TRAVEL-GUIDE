# Prevent committing real credentials.
# Copy to .env (git-ignored) and fill locally. Values live in
# workspace-root ../secrets/api-keys.env — never paste them here.
# Names only below.

# Maps / places data (pick one per SPEC §8)
MAPS_API_KEY=
PLACES_API_KEY=

# Text-to-speech / narration voice (on-device preferred, cloud fallback)
TTS_PROVIDER=
TTS_API_KEY=

# Optional cloud narration (opt-in only, summaries/fun-facts generation)
LLM_PROVIDER=
LLM_API_KEY=
